BootStrap: docker
From: nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

%post
    export DEBIAN_FRONTEND=noninteractive
   
    # 1. Update operating system tools
    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
        build-essential \
        curl \
        git

    # 2. Update to Python 3.11 for scvi-tools 1.4.2 requirements
    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-dev \
        python3.11-venv

    # 3. Bootstrap clean environment tools
    python3.11 -m ensurepip --default-pip
    python3.11 -m pip install --upgrade pip setuptools wheel --no-cache-dir

    # 4. Map active command targets
    ln -sf /usr/bin/python3.11 /usr/bin/python3
    ln -sf /usr/bin/python3.11 /usr/bin/python

    # 5. Core installation: Pulling wheels from the actual download mirror
    python3.11 -m pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118 --no-cache-dir

    # 6. Target scientific single-cell pipelines
    python3.11 -m pip install scvi-tools==1.4.2 muon pyparsing cycler kiwisolver anndata --no-cache-dir

%environment
    export LC_ALL=C
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH