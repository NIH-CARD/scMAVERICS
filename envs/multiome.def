Bootstrap: docker
From: condaforge/miniforge3

%environment
    export LC_ALL=en_US.utf-8
    export LANG=en_US.utf-8
    export LANGUAGE=en_US.UTF-8
    export BASH_ENV=/opt/etc/bashrc
    
    # FIX: Explicitly inject dreampy into Python's path system-wide
    export PYTHONPATH="/opt/dreampy:$PYTHONPATH"
    
    . /opt/etc/bashrc
%post
    apt-get update && apt-get install -y \
        build-essential \
        gcc \
        g++ \
        make \
        cmake \
        git \
        wget \
        ca-certificates

    mkdir -p /opt/etc
    ENVNAME='multiome'

    # Create environment using mamba
    mamba create -y -n multiome -c conda-forge -c bioconda \
        python=3.11 \
        pip setuptools wheel \
        muon pandas numpy matplotlib seaborn scipy statsmodels \
        conda-forge::decoupler-py=2.1.6 macs3 pybedtools biopython polars \
        anndata=0.12.11 bioconda::pyrle

    # Clone dreampy directly into a shared system directory
    git clone https://github.com/sbwells22/dreampy.git /opt/dreampy
    cd /opt/dreampy
    
    # Pre-install scikit-misc so dependencies are satisfied
    mamba install -y -n multiome -c conda-forge scikit-misc

    # MOODS installation
    conda run -n multiome python -m pip install -v --no-cache-dir moods-python

    # Install the rest of pip-dependent packages
    conda run -n multiome python -m pip install \
        snapatac2==2.9 circe-py greatpy pychromvar \
        pybigwig pyjaspar pyranges scvi-tools==1.4.2 cellphonedb \
        upsetplot gseapy adjustText 
    
    # Minimize size of image
    conda clean -a -y
    apt-get clean

    # Finalize bashrc file cleanly
    # Ensure conda init targets the absolute path inside the image
    conda init --system bash
    
    echo "#! /bin/bash" > /opt/etc/bashrc
    echo ". /opt/conda/etc/profile.d/conda.sh" >> /opt/etc/bashrc
    echo "echo \"Activating ${ENVNAME}\"" >> /opt/etc/bashrc
    echo "conda activate ${ENVNAME}" >> /opt/etc/bashrc

%runscript
    # Safely sources the environment setup before passing commands
    . /opt/etc/bashrc
    exec "$@"
